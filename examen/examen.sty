\newcommand{\Apply@consignes}{%
  \begingroup
  \long\def\@true{true}\long\def\@false{false}%
  \noindent\fbox{%
  \begin{minipage}{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}
  % ---------------------------------------------------------------------
  % document réponse 
  % ---------------------------------------------------------------------
  \ifeditiongrillereponse
    \iflanguage{francais}{%
        \textbf{Les réponses seront exclusivement reportées sur le
        document réponse. Aucun autre document ne sera corrigé. 
        Soyez aussi concis que possible et utilisez l'espace à bon escient}\\

    }{%
        \textbf{Responses will be reported exclusively on the
        response document. No other document will be marked.
        Be as concise as possible and use the available spacing wisely.}\\

    }
  \fi
  % ---------------------------------------------------------------------
  % documents autorisés
  % ---------------------------------------------------------------------
  \ifx\@documentautorise\@true 
    \iflanguage{francais}{%
        \textbf{Documents autorisés.}\\

    }{%
        \textbf{Use of documents is authorized}.\\

    }%
  \fi
  % ---------------------------------------------------------------------
  % documents non autorisés
  % ---------------------------------------------------------------------
  \ifx\@documentautorise\@false
    \iflanguage{francais}{%
        \textbf{Documents non autorisés.}\\

    }{%
        \textbf{Use of documents is not authorized.}\\

    }%
  \fi
  % ---------------------------------------------------------------------
  % moyen de calcul autorisé
  % ---------------------------------------------------------------------
  \ifx\@moyencalcul\@true
    \iflanguage{francais}{%
    \textbf{Moyens de calculs autorisés }: calculatrice de
            poche, calculatrice non programmable, alphanumérique ou à
            écran graphique, à fonctionnement autonome, non imprimante, autorisée
            conformément à la circulaire \no 99-186 du 16 novembre 1999.\\

    }{%
    \textbf{Means of calculation authorized:} the used of pocket calculators
            are strictly permitted, including non programmable calculators,
            alphanumeric, graphic display, stand-alone or non-printer are permitted
            in accordance with circular n°99-186 of November 16, 1999.\\

    }%
  \fi
  \ifx\@moyencalcul\@false
    \iflanguage{francais}{%
    \textbf{Moyens de calculs non autorisés.}\\

    }{%
    \textbf{Means of calculation not authorized.}\\

    }%
  \fi
  % ---------------------------------------------------------------------
  % dispositions à prendre en cas d'erreur 
  % ---------------------------------------------------------------------
  \ifx\@dispositions\@true
    \iflanguage{francais}{%
        \textbf{Le ou la candidate qui décèle ce qu'il ou elle pense être une erreur d'énoncé
        doit indiquer toutes les dispositions et initiatives qu'il ou elle est amené
        à prendre pour poursuivre son travail.}\\

    }{%
        \textbf{Any candidate who detects what he/she thinks was a statement error
        must indicate the means and initiatives he/she takes to continue
        his/her work.}\\

    }
  \fi
  % ---------------------------------------------------------------------
  % Consigne QCM 
  % ---------------------------------------------------------------------
  \ifx\@qcm\@true
    \ifexamen@amc
      \iflanguage{francais}{%
          \textbf{Cochez ou noircissez entièrement, au stylo noir ou bleu foncé, les cases correspondant aux bonnes réponses.}\\
      }{%
          \textbf{Fill in completely, with a dark pen, the boxes corresponding to the correct answers.}\\
      }
    \else
      \iflanguage{francais}{%
          \textbf{Lorsque la question est à choix multiples, entourer la ou les bonnes réponses directement sur le document.}\\
      }{%
          \textbf{For multiple-choice questions, please circle the correct answer(s) directly on the document.}\\
      }
    \fi
  \fi
  % ---------------------------------------------------------------------
  % Consigne QCM GRADESCOPE 
  % ---------------------------------------------------------------------
  \ifx\@qcmgradescope\@true
     \iflanguage{francais}{%
        \textbf{Les réponses seront exclusivement reportées sur le
                document réponse. Aucun autre document ne sera corrigé. 
                Indiqué la version de l'énoncé sur celui-ci.}\\

     }{%
        \textbf{Answers must be submitted exclusively on the answer 
                sheet. No other documents will be marked.
                Indicate the version of the problem statement on this sheet.}\\

     }
  \fi
  % ---------------------------------------------------------------------
  % Consigne Soin 
  % ---------------------------------------------------------------------
  \ifx\@soin\@true
     \iflanguage{francais}{%
        \textbf{Attention au soin apporté à votre copie ! Des points négatifs si les réponses sont illisibles et/ou si les figures
                manquent de clarté. Pensez à utiliser le papier brouillon pour mettre vos idées au clair avant de répondre sur la copie.}\\

     }{%
        \textbf{Pay close attention to the neatness of your work! 
                Points will be deducted if answers are illegible and/or figures lack clarity. 
                Remember to use scrap paper to organize your thoughts before writing on your final copy.}\\

     }
  \fi
  % ---------------------------------------------------------------------
  % Consigne Malus 
  % ---------------------------------------------------------------------
  \ifx\@malus\@true
     \iflanguage{francais}{%
        \textbf{Ne répondez pas au hasard car une réponse fausse est sanctionnée d'un malus pour compenser le biais lié au hasard.
                Le malus est de $\frac{-1}{3}$, ce qui fait que trois réponses fausses annulent une réponse juste.}\\

     }{%
        \textbf{Don't guess your answers, as an incorrect answer will incur a penalty to offset the bias introduced by random chance. 
                The penalty is $\frac{-1}{3}$, meaning three incorrect answers cancel out one correct answer.}\\

     }
  \fi
  % ---------------------------------------------------------------------
  % Consigne Version Moodle 
  % ---------------------------------------------------------------------
  \ifx\@moodle\@true
     \iflanguage{francais}{%
         \textbf{Cet examen est la version papier d'une évaluation Coderunner initialement conçue pour Moodle. 
                 Si certains types de questions restent inchangées, les exercices de programmation 
                 conservent leur contenu mais perdent les fonctionnalités interactives et les vérifications 
                 automatiques propres à Coderunner; l’expérience utilisateur s’en trouve nécessairement dégradée.}\\

     }{%
        \textbf{This exam is the paper version of a Coderunner assessment originally designed for Moodle. 
                While the multiple-choice questions remain unchanged, the programming exercises retain their content 
                but lack the interactive features and automatic checks provided by Coderunner, 
                resulting in a necessarily degraded user experience."}\\
     }
  \fi
  % ---------------------------------------------------------------------
  % Message d'entrain 
  % ---------------------------------------------------------------------
  \ifx\@luck\@true
     \iflanguage{francais}{%
        \textbf{Bon courage !}\\

     }{%
        \textbf{Good luck !}\\

     }
  \fi
  \end{minipage}% 
  }%
\endgroup
}
