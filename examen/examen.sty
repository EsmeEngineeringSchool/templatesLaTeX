\iflanguage{francais}{%
    \newcommand\name{Prénom et Nom :}
    \newcommand\exercicetitle{Exercice}
    \newcommand\dureetitle{Durée}
    \newcommand\heuretitle[1]{%
      \IfSubStr{#1}{minute}{%
        #1% Affiche directement "10 minutes" sans test numérique
      }{%
        #1~heure\ifnum#1>1 s\fi\relax% Comportement initial pour les heures (ex: 2 -> 2 heures)
      }%
    }
}{%
    \newcommand\name{Name :}
    \newcommand\exercicetitle{Exercise}
    \newcommand\dureetitle{Time}
    \newcommand\heuretitle[1]{%
      \IfSubStr{#1}{minute}{%
        #1% Affiche directement le texte en anglais (ex: 10 minutes)
      }{%
        #1~hour\ifnum#1>1 s\fi\relax% Comportement initial (ex: 2 -> 2 hours)
      }%
    }
}

